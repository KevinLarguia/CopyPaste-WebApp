# ID de la planilla: esta en la URL, entre /d/ y /edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890

# Email de la cuenta de servicio (termina en .iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=copypaste-app@mi-proyecto.iam.gserviceaccount.com

# Clave privada del JSON de la cuenta de servicio.
# Va entre comillas dobles y con los \n literales, tal cual viene en el JSON.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# Clave unica compartida del local. Si la dejas vacia, la app queda abierta.
APP_PASSWORD=cambiala
